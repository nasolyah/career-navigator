{
  // Cloudflare Workers: один воркер отдаёт статику из public/ и API /api/map.
  // Секрет GEMINI_API_KEY задаётся в дашборде (Settings → Variables and Secrets), не здесь.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "career-navigator",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
